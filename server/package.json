{
  "name": "portfolio-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for the portfolio: contact form, visitor book, view counts, GitHub activity, terminal ask.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@upstash/redis": "^1.39.0",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "resend": "^6.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
