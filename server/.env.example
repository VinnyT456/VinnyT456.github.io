# Copy to server/.env for local dev. On Render, set these in the dashboard.

# Who may call the API from a browser (comma-separated, no trailing slash)
ALLOWED_ORIGIN=http://localhost:3000

# Contact form + visitor-book notifications (resend.com)
RESEND_API_KEY=
CONTACT_EMAIL=
# optional, once you verify a domain in Resend:
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>

# Visitor book (Neon Postgres connection string)
DATABASE_URL=

# Long random string; lets you hide a visitor-book entry:
#   curl -X DELETE <api>/guestbook/<id> -H "Authorization: Bearer $ADMIN_TOKEN"
ADMIN_TOKEN=

# optional extra blocked words for visitor-book names, comma-separated
# BLOCKED_WORDS=

# Exhibit view counts + the daily `ask` cap (upstash.com → Redis → REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# optional salt for hashing visitor IPs in view counts (defaults to ADMIN_TOKEN)
# VIEW_SALT=

# GitHub: latest push, repo stats and the contribution heatmap.
# The heatmap needs a token (GitHub's calendar is GraphQL-only): a classic
# token with NO scopes is enough. Push + repo stats work without one.
# GITHUB_USER=VinnyT456
GITHUB_TOKEN=

# Terminal `ask` (aistudio.google.com → Get API key)
GEMINI_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it
# ASK_DAILY_LIMIT=150
