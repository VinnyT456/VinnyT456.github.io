# Contact form (server-only — never prefix with NEXT_PUBLIC_)

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered.
# EMAIL_ADDRESS is the existing convention; CONTACT_EMAIL also works and wins if set.
EMAIL_ADDRESS=you@example.com
# CONTACT_EMAIL=you@example.com

# From address for outgoing mail. Optional.
# Defaults to Resend's shared sender ("onboarding@resend.dev"), which works
# immediately for testing. For production, verify a domain in Resend and set:
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>
# CONTACT_FROM_EMAIL=
